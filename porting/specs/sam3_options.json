{
  "library": "transformers",
  "architecture": "Sam3Model",
  "model_type": "sam3",
  "config": {
    "vision_config": {
      "backbone_config": {
        "model_type": "sam3_vit_model",
        "hidden_size": 24,
        "intermediate_size": 32,
        "num_hidden_layers": 3,
        "num_attention_heads": 3,
        "image_size": 36,
        "patch_size": 6,
        "window_size": 3,
        "global_attn_indexes": [
          0,
          2
        ],
        "pretrain_image_size": 36,
        "hidden_act": "gelu_pytorch_tanh",
        "layer_norm_eps": 1e-05,
        "rope_parameters": {
          "rope_type": "axial",
          "rope_theta": 100.0
        }
      },
      "fpn_hidden_size": 16,
      "scale_factors": [
        2.0,
        1.0,
        0.5
      ]
    },
    "text_config": {
      "vocab_size": 50,
      "hidden_size": 16,
      "intermediate_size": 20,
      "projection_dim": 8,
      "num_hidden_layers": 1,
      "num_attention_heads": 4,
      "max_position_embeddings": 6,
      "hidden_act": "quick_gelu",
      "layer_norm_eps": 1e-06,
      "eos_token_id": 2
    },
    "geometry_encoder_config": {
      "hidden_size": 16,
      "num_layers": 1,
      "num_attention_heads": 4,
      "intermediate_size": 16,
      "roi_size": 2,
      "hidden_act": "gelu"
    },
    "detr_encoder_config": {
      "hidden_size": 16,
      "num_layers": 1,
      "num_attention_heads": 4,
      "intermediate_size": 16
    },
    "detr_decoder_config": {
      "hidden_size": 16,
      "num_layers": 3,
      "num_queries": 4,
      "num_attention_heads": 4,
      "intermediate_size": 20
    },
    "mask_decoder_config": {
      "hidden_size": 16,
      "num_upsampling_stages": 1,
      "num_attention_heads": 4
    }
  },
  "inputs": {
    "batch": 3,
    "boxes": 2
  },
  "tap_depth": 2
}
