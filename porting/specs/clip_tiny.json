{
  "library": "transformers",
  "architecture": "CLIPModel",
  "model_type": "clip",
  "config": {
    "text_config": {
      "vocab_size": 64,
      "hidden_size": 16,
      "intermediate_size": 24,
      "num_hidden_layers": 2,
      "num_attention_heads": 2,
      "max_position_embeddings": 8,
      "eos_token_id": 40
    },
    "vision_config": {
      "hidden_size": 24,
      "intermediate_size": 32,
      "num_hidden_layers": 2,
      "num_attention_heads": 2,
      "image_size": 16,
      "patch_size": 4
    },
    "projection_dim": 12,
    "logit_scale_init_value": 1.5
  },
  "inputs": {"texts": 2, "lengths": [8, 5], "images": 3},
  "tap_depth": 3
}
