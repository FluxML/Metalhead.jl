{
  "library": "transformers",
  "architecture": "CLIPModel",
  "model_type": "clip",
  "config": {
    "text_config": {
      "vocab_size": 50,
      "hidden_size": 12,
      "intermediate_size": 20,
      "num_hidden_layers": 1,
      "num_attention_heads": 3,
      "max_position_embeddings": 10,
      "hidden_act": "gelu",
      "layer_norm_eps": 1e-6,
      "eos_token_id": 2
    },
    "vision_config": {
      "hidden_size": 16,
      "intermediate_size": 20,
      "num_hidden_layers": 2,
      "num_attention_heads": 4,
      "image_size": 12,
      "patch_size": 4,
      "hidden_act": "gelu",
      "layer_norm_eps": 1e-6
    },
    "projection_dim": 8
  },
  "inputs": {"texts": 3, "seq_len": 6, "images": 2, "image_size": [20, 24],
             "interpolate_pos_encoding": true},
  "tap_depth": 3
}
