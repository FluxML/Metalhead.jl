{
  "library": "transformers",
  "architecture": "Siglip2Model",
  "model_type": "siglip2",
  "config": {
    "text_config": {"vocab_size": 50, "hidden_size": 12, "intermediate_size": 20,
                    "num_hidden_layers": 1, "num_attention_heads": 2,
                    "max_position_embeddings": 8, "hidden_act": "gelu",
                    "projection_size": 16},
    "vision_config": {"hidden_size": 16, "intermediate_size": 28, "num_hidden_layers": 2,
                      "num_attention_heads": 4, "num_channels": 1, "patch_size": 3,
                      "num_patches": 25, "hidden_act": "quick_gelu", "layer_norm_eps": 1e-5}
  },
  "inputs": {"texts": 3, "seq_len": 7, "lengths": [7, 2, 4],
             "spatial_shapes": [[2, 7], [6, 2]], "max_num_patches": 14, "pixel_mask": false},
  "tap_depth": 3
}
