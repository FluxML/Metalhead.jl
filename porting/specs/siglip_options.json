{
  "library": "transformers",
  "architecture": "SiglipModel",
  "model_type": "siglip",
  "config": {
    "text_config": {"vocab_size": 50, "hidden_size": 12, "intermediate_size": 20,
                    "num_hidden_layers": 1, "num_attention_heads": 3,
                    "max_position_embeddings": 8, "hidden_act": "gelu",
                    "layer_norm_eps": 1e-5, "projection_size": 16},
    "vision_config": {"hidden_size": 16, "intermediate_size": 28, "num_hidden_layers": 2,
                      "num_attention_heads": 4, "num_channels": 2, "image_size": 12,
                      "patch_size": 4, "hidden_act": "quick_gelu", "layer_norm_eps": 1e-5}
  },
  "inputs": {"texts": 3, "seq_len": 6, "lengths": [5, 6, 3], "images": 2,
             "image_size": [8, 20], "interpolate_pos_encoding": true},
  "tap_depth": 3
}
