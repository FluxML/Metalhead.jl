{
  "library": "transformers",
  "architecture": "CLIPTextModel",
  "model_type": "clip_text_model",
  "config": {
    "vocab_size": 64,
    "hidden_size": 16,
    "intermediate_size": 24,
    "num_hidden_layers": 2,
    "num_attention_heads": 4,
    "max_position_embeddings": 9,
    "hidden_act": "gelu_pytorch_tanh",
    "eos_token_id": 63
  },
  "inputs": {"texts": 3, "lengths": [9, 4, 6]},
  "tap_depth": 3
}
