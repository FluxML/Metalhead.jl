{
  "architectures": [
    "LlamaForCausalLM"
  ],
  "attention_bias": true,
  "attention_dropout": 0.1,
  "bos_token_id": 1,
  "dtype": "float32",
  "eos_token_id": 2,
  "head_dim": 12,
  "hidden_act": "silu",
  "hidden_size": 24,
  "initializer_range": 0.02,
  "intermediate_size": 20,
  "max_position_embeddings": 2048,
  "mlp_bias": true,
  "model_type": "llama",
  "num_attention_heads": 3,
  "num_hidden_layers": 3,
  "num_key_value_heads": 3,
  "pad_token_id": null,
  "pretraining_tp": 1,
  "rms_norm_eps": 1e-06,
  "rope_parameters": {
    "rope_theta": 10000.0,
    "rope_type": "default"
  },
  "tie_word_embeddings": false,
  "transformers_version": "5.20.2",
  "use_cache": true,
  "vocab_size": 40
}
